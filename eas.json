{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
        "distribution": "internal",
        "android": {
            "buildType": "apk"
        },
        "env": {
            "EXPO_PUBLIC_API_URL": "https://api.seere.cloud",
            "EXPO_PUBLIC_SERVICE_UUID": "6e400001-b5a3-f393-e0a9-e50e24dcca9e",
            "EXPO_PUBLIC_C_CHARACTERISTIC_UUID_RX": "6e400002-b5a3-f393-e0a9-e50e24dcca9e",
            "EXPO_PUBLIC_C_CHARACTERISTIC_UUID_TX": "6e400003-b5a3-f393-e0a9-e50e24dcca9e"
        }
    },
    "production": {
        "autoIncrement": true,
        "android": {
            "buildType": "apk"
        },
        "env": {
            "EXPO_PUBLIC_API_URL": "https://api.seere.cloud",
            "EXPO_PUBLIC_SERVICE_UUID": "6e400001-b5a3-f393-e0a9-e50e24dcca9e",
            "EXPO_PUBLIC_C_CHARACTERISTIC_UUID_RX": "6e400002-b5a3-f393-e0a9-e50e24dcca9e",
            "EXPO_PUBLIC_C_CHARACTERISTIC_UUID_TX": "6e400003-b5a3-f393-e0a9-e50e24dcca9e"
        }
    }
  }
}
